Soru 1: Hangi şehirde ne kadarlık satış yapıldığı bilgisi

SELECT 
    C.CITY, 
    SUM(O.TOTALPRICE) AS TOTALSALE
FROM ORDERS O
JOIN ADDRESS A ON O.ADDRESSID = A.ID
JOIN CITIES C ON A.CITYID = C.ID
GROUP BY C.CITY
ORDER BY TOTALSALE DESC;

Soru 2: Şehirlere göre hangi ayda ne kadarlık satış yapıldığı bilgisi

SELECT 
    C.CITY, 
    DATENAME(MONTH, O.DATE) AS MONTHNAME, 
    SUM(O.TOTALPRICE) AS TOTALSALE
FROM ORDERS O
JOIN ADDRESS A ON O.ADDRESSID = A.ID
JOIN CITIES C ON A.CITYID = C.ID
GROUP BY C.CITY, DATENAME(MONTH, O.DATE), MONTH(O.DATE)
ORDER BY C.CITY, MONTH(O.DATE);

Soru 3: Şehirlerin haftanın günlerine göre ne kadarlık satış yaptığı bilgisi (Satır bazlı liste)

SELECT 
    C.CITY, 
    DATENAME(WEEKDAY, O.DATE) AS DAYOFWEEK, 
    SUM(O.TOTALPRICE) AS TOTALSALE
FROM ORDERS O
JOIN ADDRESS A ON O.ADDRESSID = A.ID
JOIN CITIES C ON A.CITYID = C.ID
GROUP BY C.CITY, DATENAME(WEEKDAY, O.DATE), DATEPART(WEEKDAY, O.DATE)
ORDER BY C.CITY, DATEPART(WEEKDAY, O.DATE);

Soru 4: Şehirlerin haftanın günlerine göre satışlarının gün bazında sütunlara dökülmesi (PIVOT)

SELECT 
    CITY,
    ISNULL([Pazartesi], 0) AS PAZARTESİ,
    ISNULL([Salı], 0) AS SALI,
    ISNULL([Çarşamba], 0) AS ÇARŞAMBA,
    ISNULL([Perşembe], 0) AS PERŞEMBE,
    ISNULL([Cuma], 0) AS CUMA,
    ISNULL([Cumartesi], 0) AS CUMARTESİ,
    ISNULL([Pazar], 0) AS PAZAR
FROM (
    SELECT 
        C.CITY, 
        DATENAME(WEEKDAY, O.DATE) AS DAYOFWEEK, 
        O.TOTALPRICE
    FROM ORDERS O
    JOIN ADDRESS A ON O.ADDRESSID = A.ID
    JOIN CITIES C ON A.CITYID = C.ID
) AS SourceTable
PIVOT (
    SUM(TOTALPRICE)
    FOR DAYOFWEEK IN ([Pazartesi], [Salı], [Çarşamba], [Perşembe], [Cuma], [Cumartesi], [Pazar])
) AS PivotTable
ORDER BY CITY;

