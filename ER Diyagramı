CREATE DATABASE ETICARET;
GO
USE ETICARET;
GO

-- 1. Ülkeler Tablosu
CREATE TABLE COUNTRIES (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    COUNTRY VARCHAR(100) NOT NULL
);

-- 2. Şehirler Tablosu
CREATE TABLE CITIES (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    COUNTRYID INT FOREIGN KEY REFERENCES COUNTRIES(ID),
    CITY VARCHAR(100) NOT NULL
);

-- 3. İlçeler Tablosu
CREATE TABLE TOWNS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    CITYID INT FOREIGN KEY REFERENCES CITIES(ID),
    TOWN VARCHAR(100) NOT NULL
);

-- 4. Semt/Mahalle Tablosu
CREATE TABLE DISTRICTS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    TOWNID INT FOREIGN KEY REFERENCES TOWNS(ID),
    DISTRICT VARCHAR(100) NOT NULL
);

-- 5. Kullanıcılar Tablosu
CREATE TABLE USERS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    USERNAME VARCHAR(50) NOT NULL,
    PASSWORD VARCHAR(100) NOT NULL,
    NAMESURNAME VARCHAR(100) NOT NULL,
    EMAIL VARCHAR(100),
    GENDER VARCHAR(10),
    BIRTHDATE DATE,
    CREATEDDATE DATETIME DEFAULT GETDATE(),
    TELNR1 VARCHAR(20),
    TELNR2 VARCHAR(20)
);

-- 6. Adresler Tablosu
CREATE TABLE ADDRESS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    USERID INT FOREIGN KEY REFERENCES USERS(ID),
    COUNTRYID INT FOREIGN KEY REFERENCES COUNTRIES(ID),
    CITYID INT FOREIGN KEY REFERENCES CITIES(ID),
    TOWNID INT FOREIGN KEY REFERENCES TOWNS(ID),
    DISTRICTID INT FOREIGN KEY REFERENCES DISTRICTS(ID),
    POSTALCODE VARCHAR(10),
    ADDRESSTEXT VARCHAR(500)
);

-- 7. Ürünler Tablosu
CREATE TABLE ITEMS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    ITEMCODE VARCHAR(50),
    ITEMNAME VARCHAR(250) NOT NULL,
    UNITPRICE DECIMAL(18,2),
    CATEGORY1 VARCHAR(100),
    CATEGORY2 VARCHAR(100),
    CATEGORY3 VARCHAR(100),
    CATEGORY4 VARCHAR(100),
    BRAND VARCHAR(100)
);

-- 8. Siparişler Tablosu
CREATE TABLE ORDERS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    USERID INT FOREIGN KEY REFERENCES USERS(ID),
    DATE DATETIME DEFAULT GETDATE(),
    TOTALPRICE DECIMAL(18,2),
    STATUS INT,
    ADDRESSID INT FOREIGN KEY REFERENCES ADDRESS(ID)
);

-- 9. Sipariş Detayları Tablosu
CREATE TABLE ORDERDETAILS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    ORDERID INT FOREIGN KEY REFERENCES ORDERS(ID),
    ITEMID INT FOREIGN KEY REFERENCES ITEMS(ID),
    AMOUNT INT,
    UNITPRICE DECIMAL(18,2),
    LINETOTAL DECIMAL(18,2)
);

-- 10. Ödemeler Tablosu
CREATE TABLE PAYMENTS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    ORDERID INT FOREIGN KEY REFERENCES ORDERS(ID),
    PAYMENTTYPE INT,
    DATE DATETIME DEFAULT GETDATE(),
    ISOK BIT,
    APPROVECODE VARCHAR(100),
    PAYMENTTOTAL DECIMAL(18,2)
);

-- 11. Faturalar Tablosu
CREATE TABLE INVOICES (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    ORDERID INT FOREIGN KEY REFERENCES ORDERS(ID),
    DATE DATETIME DEFAULT GETDATE(),
    ADDRESSID INT FOREIGN KEY REFERENCES ADDRESS(ID),
    CARGOFICHENO VARCHAR(100),
    TOTALPRICE DECIMAL(18,2)
);

-- 12. Fatura Detayları Tablosu
CREATE TABLE INVOICEDETAILS (
    ID INT IDENTITY(1,1) PRIMARY KEY,
    INVOICEID INT FOREIGN KEY REFERENCES INVOICES(ID),
    ORDERDETAILID INT FOREIGN KEY REFERENCES ORDERDETAILS(ID),
    ITEMID INT FOREIGN KEY REFERENCES ITEMS(ID),
    AMOUNT INT,
    UNITPRICE DECIMAL(18,2),
    LINETOTAL DECIMAL(18,2)
);
