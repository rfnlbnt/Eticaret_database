Soru 5: Her ilin en çok satan ilk 5 kategorisi (CATEGORY1)

WITH CityCategorySales AS (
    SELECT 
        C.CITY,
        I.CATEGORY1,
        SUM(OD.LINETOTAL) AS TOTALSALE,
        ROW_NUMBER() OVER(PARTITION BY C.CITY ORDER BY SUM(OD.LINETOTAL) DESC) AS RowNum
    FROM ORDERS O
    JOIN ADDRESS A ON O.ADDRESSID = A.ID
    JOIN CITIES C ON A.CITYID = C.ID
    JOIN ORDERDETAILS OD ON O.ID = OD.ORDERID
    JOIN ITEMS I ON OD.ITEMID = I.ID
    GROUP BY C.CITY, I.CATEGORY1
)
SELECT 
    CITY, 
    CATEGORY1, 
    TOTALSALE
FROM CityCategorySales
WHERE RowNum <= 5
ORDER BY CITY, TOTALSALE DESC;

Soru 6: Her şehirde en çok satış yapılan ilk 3 kategori ve her birinin altında en çok satan ilk 3 alt kategori (CATEGORY2)

WITH TopCategories AS (
    SELECT 
        C.CITY,
        I.CATEGORY1,
        ROW_NUMBER() OVER(PARTITION BY C.CITY ORDER BY SUM(OD.LINETOTAL) DESC) AS CatRank
    FROM ORDERS O
    JOIN ADDRESS A ON O.ADDRESSID = A.ID
    JOIN CITIES C ON A.CITYID = C.ID
    JOIN ORDERDETAILS OD ON O.ID = OD.ORDERID
    JOIN ITEMS I ON OD.ITEMID = I.ID
    GROUP BY C.CITY, I.CATEGORY1
),
SubCategorySales AS (
    SELECT 
        C.CITY,
        I.CATEGORY1,
        I.CATEGORY2,
        SUM(OD.LINETOTAL) AS TOTALSALE,
        ROW_NUMBER() OVER(PARTITION BY C.CITY, I.CATEGORY1 ORDER BY SUM(OD.LINETOTAL) DESC) AS SubCatRank
    FROM ORDERS O
    JOIN ADDRESS A ON O.ADDRESSID = A.ID
    JOIN CITIES C ON A.CITYID = C.ID
    JOIN ORDERDETAILS OD ON O.ID = OD.ORDERID
    JOIN ITEMS I ON OD.ITEMID = I.ID
    JOIN TopCategories TC ON C.CITY = TC.CITY AND I.CATEGORY1 = TC.CATEGORY1
    WHERE TC.CatRank <= 3
    GROUP BY C.CITY, I.CATEGORY1, I.CATEGORY2
)
SELECT 
    CITY,
    CATEGORY1,
    CATEGORY2,
    TOTALSALE
FROM SubCategorySales
WHERE SubCatRank <= 3
ORDER BY CITY, CATEGORY1, TOTALSALE DESC;
